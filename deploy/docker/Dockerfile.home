# Home-server image: the stock image plus what a Telegram assistant needs
# when the LLM runs on another machine (Ollama on a desktop PC):
#   - inference-cloud  (Anthropic/OpenAI clients for [engine.cloud_fallback])
#   - speech           (faster-whisper: transcribe voice notes)
#   - kokoro + CPU-only PyTorch (local voice replies)
#
# PyTorch comes from the CPU wheel index on purpose: the version pinned in
# uv.lock is the PyPI build, which on Linux drags in ~3 GB of CUDA libraries a
# GPU-less NAS will never use.
#
# Mount a volume at /home/openjarvis: it holds ~/.openjarvis (config, knowledge
# store, sessions, scheduler) and ~/.cache (Kokoro / Whisper / HF models), so a
# container recreate neither loses state nor re-downloads ~0.5 GB of models.
#
# Build from the repo root (or straight from a git URL):
#   docker build -f deploy/docker/Dockerfile.home -t openjarvis:home .

# Stage 1: Build frontend SPA
FROM node:22.23.0-slim@sha256:d9f850096136edbc402debdd8729579a288aac64574ada0ff4db26b6ae58b0b2 AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install
COPY frontend/ .
RUN VITE_SUPABASE_ANON_KEY="" npm run build

# Stage 2: Build Python package
FROM python:3.12.13-slim-bookworm@sha256:76d4b7b6305788c6b4c6a19d6a22a3921bf802e9af4d5e1e5bd771208dba74bf AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --profile minimal --default-toolchain none && \
    rustup toolchain install 1.89 --profile minimal && \
    rustup default 1.89

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN pip install --no-cache-dir uv && \
    uv export --frozen --no-dev --extra server --extra inference-cloud --extra speech \
        --no-emit-project > requirements.txt && \
    uv pip install --system --no-deps -r requirements.txt && \
    uv pip install --system --no-deps "maturin>=1.12.6,<2"

# CPU-only PyTorch first, then Kokoro: its torch requirement is already met,
# so the resolver does not pull the CUDA build.
RUN uv pip install --system --index-url https://download.pytorch.org/whl/cpu torch && \
    uv pip install --system "kokoro>=0.9" "soundfile>=0.12" && \
    python3 -c "import torch; assert not torch.version.cuda, torch.version.cuda; print('torch', torch.__version__, 'cpu')"

COPY src/ src/
COPY rust/ rust/
COPY scripts/install scripts/install
COPY deploy/windows deploy/windows
COPY --from=frontend /src/openjarvis/server/static src/openjarvis/server/static/

RUN uv pip install --system --no-deps . && \
    maturin build --release \
        --manifest-path rust/crates/openjarvis-python/Cargo.toml \
        --interpreter python3 \
        --out /tmp/openjarvis-rust-wheel && \
    uv pip install --system --no-deps /tmp/openjarvis-rust-wheel/*.whl && \
    python3 -c "import openjarvis_rust; print('openjarvis_rust ok')" && \
    python3 -m pip uninstall -y maturin && \
    rm -rf /tmp/openjarvis-rust-wheel rust

# Stage 3: Runtime
FROM python:3.12.13-slim-bookworm@sha256:76d4b7b6305788c6b4c6a19d6a22a3921bf802e9af4d5e1e5bd771208dba74bf

# libportaudio2: sounddevice (pulled by the voice/speech extras) loads it at
# import time even though the server never plays audio.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libportaudio2 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local
COPY --from=builder /app /app
WORKDIR /app

RUN groupadd --system --gid 10001 openjarvis && \
    useradd --system --uid 10001 --gid openjarvis \
        --create-home --home-dir /home/openjarvis openjarvis
ENV HOME=/home/openjarvis \
    PYTHONUNBUFFERED=1
USER openjarvis

EXPOSE 8000
HEALTHCHECK --interval=60s --timeout=5s --start-period=120s --retries=3 \
    CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"

ENTRYPOINT ["jarvis"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
